<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Copied from backend/nupkgs before docker build. Host restore can also use this folder. -->
    <add key="ecommerce-local" value="./nupkgs" />
  </packageSources>
</configuration>
