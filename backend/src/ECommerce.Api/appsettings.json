{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ecommerce-core",
    "Audience": "ecommerce-clients",
    "Key": "CHANGE_ME_SUPER_SECRET_AT_LEAST_32_CHARS_LONG_1234",
    "ExpiryMinutes": 60
  },
  "ConnectionStrings": {
    "Default": "Host=db;Port=5432;Database=ecommerce;Username=ecommerce;Password=ecommerce"
  },
  "PluginRuntime": {
    "DockerEndpoint": "unix:///var/run/docker.sock",
    "Network": "ecommerce_plugins",
    "ContainerPrefix": "ecom-plugin-",
    "HealthTimeout": "00:00:30",
    "BrokerHost": "rabbitmq",
    "BrokerPort": 5672,
    "BrokerUsername": "ecommerce",
    "BrokerPassword": "ecommerce",
    "BrokerVirtualHost": "/"
  },
  "Marketplace": {
    "CatalogPath": "/app/marketplace/catalog.json"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200", "http://localhost:8080" ]
  }
}
